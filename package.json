{
  "name": "sunshine-run-gui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "酷动·阳光跑 —— 校园跑图形助手（Nuxt3 + Vuetify）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.json",
    "verify:render": "node scripts/verify-render.mjs",
    "verify:capture": "node scripts/verify-capture.mjs",
    "verify:demo": "node scripts/verify-demo.mjs",
    "core:sync": "node scripts/sync-core.mjs",
    "core:test": "node scripts/selftest.mjs",
    "mock": "node scripts/mock-server.mjs",
    "release": "node scripts/release.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@mdi/font": "7.4.47",
    "nuxt": "3.9.1",
    "vite-plugin-vuetify": "2.1.3",
    "vue": "3.4.21",
    "vue-router": "4.3.0",
    "vuetify": "3.4.10"
  },
  "devDependencies": {
    "typescript": "5.3.3",
    "vue-tsc": "1.8.27"
  }
}
